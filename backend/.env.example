# ── SunuTribunal — Variables d'environnement ──────────────────────
# Copiez ce fichier en .env et remplissez les valeurs

# Django
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
DB_NAME=sunutribunal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS — URL du frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=votre-app-password

# Firebase (notifications push)
FIREBASE_CREDENTIALS=path/to/firebase-credentials.json

# Twilio (SMS réels — confirmation / rejet des rendez-vous)
# Console Twilio → Account Info. Laisser vide = SMS non envoyés (inscrits au journal).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Code de la juridiction dans les numéros de registre (si l'agent n'a pas de tribunal)
# Ex : CA-00142/2026/TIDK
CODE_JURIDICTION=TIDK

# Google Maps API
VITE_GOOGLE_MAPS_KEY=your-google-maps-api-key
